<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="edutracker">

  <!-- ====== ПАРАМЕТРЫ ====== -->

  <xacro:property name="body_radius" value="0.0775" />
  <xacro:property name="body_height" value="0.245" />

  <xacro:property name="wheel_radius" value="0.0325" />
  <xacro:property name="wheel_width" value="0.027" />

  <material name="green">
    <color rgba="0 0.6 0 0.8" />
  </material>

  <material name="black">
    <color rgba="0 0 0 1" />
  </material>

  <!-- ====== BASE ====== -->


  <link name="base_link" />

  <link name="body_link">
      <visual>
        <geometry>
          <cylinder radius="${body_radius}" length="${body_height}" />
          <!-- <mesh
                      filename="package://edutracker_description/meshes/base.stl"
                      scale="0.001 0.001 0.001"
                  /> -->
        </geometry>

        <origin xyz="-0.047 0 0.1225" />
        <material name="green" />

      </visual>
  </link>

  <joint name="body_joint" type="fixed">
    <parent link="base_link" />
    <child link="body_link" />
    <origin xyz="0 0 0" />
  </joint>



  <!-- ====== LIDAR ====== -->

  <link name="laser_link">

    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.05" />
        <!-- <mesh
                    filename="package://edutracker_description/meshes/lidar.stl"
                    scale="0.001 0.001 0.001"
                /> -->
      </geometry>

      <origin xyz="0 0 0" />
      <material name="black" />
    </visual>

  </link>


  <joint name="laser_joint" type="fixed">

    <parent link="base_link" />
    <child link="laser_link" />

    <!-- 25 см выше базы -->
    <origin xyz="-0.047 0 0.2755" />

  </joint>


  <!-- ====== CAMERA ====== -->

  <link name="camera_link">

    <visual>
      <geometry>
        <box size="0.01 0.038 0.03" />
      </geometry>
      <material name="black" />
    </visual>

  </link>


  <joint name="camera_joint" type="fixed">

    <parent link="base_link" />
    <child link="camera_link" />

    <!-- камера чуть сбоку и выше -->
    <origin xyz="-0.01 0 0.203" />

  </joint>


  <!-- ====== КОЛЁСА ====== -->


  <link name="left_wheel_link">

    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        <!-- <mesh
                    filename="package://edutracker_description/meshes/wheel.stl"
                    scale="0.001 0.001 0.001"
                /> -->
      </geometry>

      <origin rpy="1.5708 0 0" />
      <material name="black" />
    </visual>

  </link>


  <joint name="left_wheel_joint" type="continuous">

    <parent link="base_link" />
    <child link="left_wheel_link" />

    <origin xyz="0 0.1155 0" />

    <axis xyz="0 1 0" />

  </joint>



  <link name="right_wheel_link">

    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        <!-- <mesh
                    filename="package://edutracker_description/meshes/wheel.stl"
                    scale="0.001 0.001 0.001"
                /> -->
      </geometry>

      <origin rpy="-1.5708 0 0" />
      <material name="black" />

    </visual>

  </link>


  <joint name="right_wheel_joint" type="continuous">

    <parent link="base_link" />
    <child link="right_wheel_link" />

    <origin xyz="0 -0.1155 0" />

    <axis xyz="0 1 0" />

  </joint>


</robot>
