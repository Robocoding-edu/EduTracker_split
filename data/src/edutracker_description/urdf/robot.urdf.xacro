<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="edutracker">

  <!-- ====== ПАРАМЕТРЫ ====== -->

  <xacro:property name="body_radius" value="0.125"/>
  <xacro:property name="body_height" value="0.05"/>

  <xacro:property name="wheel_radius" value="0.0325"/>
  <xacro:property name="wheel_width" value="0.02"/>

  <!-- ====== BASE ====== -->

  <link name="base_link">

    <visual>
      <geometry>
        <cylinder
          radius="${body_radius}"
          length="${body_height}"/>
      </geometry>

      <origin xyz="0 0 0"/>

    </visual>

  </link>


  <!-- ====== LIDAR ====== -->

  <link name="laser_link">

    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.05"/>
      </geometry>

      <origin xyz="0 0 0"/>
    </visual>

  </link>


  <joint name="laser_joint" type="fixed">

    <parent link="base_link"/>
    <child link="laser_link"/>

    <!-- 25 см выше базы -->
    <origin xyz="0 0 0.25"/>

  </joint>


  <!-- ====== CAMERA ====== -->

  <link name="camera_link">

    <visual>
      <geometry>
        <box size="0.04 0.04 0.03"/>
      </geometry>
    </visual>

  </link>


  <joint name="camera_joint" type="fixed">

    <parent link="base_link"/>
    <child link="camera_link"/>

    <!-- камера чуть сбоку и выше -->
    <origin xyz="0.05 0 0.20"/>

  </joint>


  <!-- ====== КОЛЁСА ====== -->


  <link name="left_wheel_link">

    <visual>
      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>

      <origin rpy="1.5708 0 0"/>
    </visual>

  </link>


  <joint name="left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel_link"/>

    <origin xyz="0 0.13 0"/>

    <axis xyz="0 1 0"/>

  </joint>



  <link name="right_wheel_link">

    <visual>
      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>

      <origin rpy="1.5708 0 0"/>

    </visual>

  </link>


  <joint name="right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel_link"/>

    <origin xyz="0 -0.13 0"/>

    <axis xyz="0 1 0"/>

  </joint>


</robot>
